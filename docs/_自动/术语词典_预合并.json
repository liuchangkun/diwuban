{
  "_说明": "项目领域术语/词典覆盖（自动初稿+可人工维护）。匹配成功时将覆盖自动推断的‘作用/功能说明’。",
  "_匹配键": "支持 equals/prefix/contains/regex；表可选 schema 过滤；API 可选 method 过滤（GET/POST...）",
  "tables": [
    {
      "equals": "fact_measurements",
      "summary": "事实明细表：时间序列度量主数据（按站/设备/指标/时刻）"
    },
    {
      "equals": "dim_stations",
      "summary": "泵站维表：站点元数据（名称、时区、属性）"
    },
    {
      "equals": "dim_devices",
      "summary": "设备维表：设备元数据（站点关联、类型、名称等）"
    },
    {
      "equals": "dim_metric_config",
      "summary": "指标配置维表：指标键、单位、展示、取值范围"
    },
    {
      "equals": "dim_mapping_items",
      "summary": "导入映射快照：源到内部维度映射记录（一致性校验）"
    },
    {
      "equals": "staging_raw",
      "summary": "装载中间表：导入阶段原始数据（UNLOGGED，清洗/合并前）"
    },
    {
      "equals": "staging_rejects",
      "summary": "装载中间表：导入阶段拒绝/错误记录（UNLOGGED）"
    },
    {
      "equals": "metric_capability_policy",
      "summary": "指标可采能力策略：记录各指标可采性与是否需要计算"
    },
    {
      "equals": "device_running_thresholds",
      "summary": "设备运行判定阈值集中配置（电流/功率/频率）"
    },
    {
      "prefix": "completion_",
      "summary": "补全/追踪审计相关：运行、步骤、失败、变更等记录"
    },
    {
      "prefix": "metrics_presence",
      "summary": "指标在场性/可用性统计（按设备/时间片统计可用指标）"
    },
    {
      "prefix": "dim_",
      "summary": "维度表：实体/枚举/元数据，供关联使用"
    },
    {
      "prefix": "fact_",
      "summary": "事实表：面向查询与统计的明细数据"
    },
    {
      "prefix": "staging_",
      "summary": "装载中间表：导入/清洗过程的过渡数据"
    },
    {
      "prefix": "mv_",
      "summary": "物化视图：预计算结果，加速读取"
    },
    {
      "prefix": "mpps_w_",
      "summary": "presence 按周期分片宽表（分区/分表，秒级聚合）"
    }
  ],
  "columns": {
    "station_id": "站点外键",
    "device_id": "设备外键",
    "metric_id": "指标外键",
    "ts_raw": "原始时间戳（timestamptz，建议UTC）",
    "ts_second": "秒级时间戳（timestamptz）",
    "ts_bucket": "桶/分箱时间戳（按粒度聚合）",
    "inserted_at": "插入时间（timestamptz）",
    "created_at": "创建时间（timestamptz）",
    "updated_at": "更新时间（timestamptz）",
    "source_hint": "数据来源线索（如文件路径/批次/版本）",
    "metrics_data": "近原始度量数据（JSON/JSONB）",
    "value": "数值（numeric/float）",
    "value_numeric": "数值（numeric）",
    "start_ts": "窗口起始时间（timestamptz）",
    "end_ts": "窗口结束时间（timestamptz）",
    "run_id": "运行ID（批次/任务标识）",
    "id": "主键ID",
    "gap_id": "缺口段ID/关联ID",
    "unit": "单位",
    "unit_display": "单位显示",
    "mapping_hash": "映射快照哈希（一致性）",
    "station_name": "站点名称（源）",
    "device_name": "设备名称（源）",
    "available_metrics": "可用指标列表（ARRAY）",
    "need_compute_metrics": "需要计算得到的指标列表（ARRAY）"
  },
  "apis": [
    {
      "method": "GET",
      "equals": "/db-health",
      "summary": "系统/数据库健康检查"
    },
    {
      "method": "GET",
      "equals": "/health",
      "summary": "系统/数据库健康检查"
    },
    {
      "method": "GET",
      "equals": "/devices",
      "summary": "查询设备与基础元数据（分页/筛选）"
    },
    {
      "method": "GET",
      "equals": "/devices/{device_id}",
      "summary": "查询设备详情"
    },
    {
      "method": "GET",
      "regex": "/devices/.*/measurements$",
      "summary": "设备时间窗度量查询（筛选指标/粒度/分页）"
    },
    {
      "method": "GET",
      "regex": "/devices/.*/raw$",
      "summary": "设备近原始数据（wide/long）"
    },
    {
      "method": "GET",
      "regex": "/stations/.*/measurements$",
      "summary": "按站点查询时间窗度量（可筛选设备/指标）"
    },
    {
      "method": "GET",
      "regex": "/stations/.*/raw$",
      "summary": "站点近原始数据（wide/long）"
    },
    {
      "method": "GET",
      "equals": "/performance",
      "summary": "系统性能指标"
    },
    {
      "method": "GET",
      "equals": "/pool-stats",
      "summary": "连接池统计"
    }
  ],
  "services": [
    {
      "path_contains": "services/admin/clear_db",
      "summary": "数据库清空/维护工具（高风险操作）"
    },
    {
      "path_contains": "services/system/cleanup",
      "summary": "系统清理：日志与数据库清理辅助"
    },
    {
      "path_contains": "services/run_all/orchestrator",
      "summary": "端到端流程编排与调度"
    },
    {
      "path_contains": "services/device_running_job",
      "summary": "设备运行/停机区段计算与落库"
    },
    {
      "path_contains": "services/ingest/create_staging",
      "summary": "创建/刷新装载中间表（幂等）"
    },
    {
      "path_contains": "services/ingest/copy",
      "summary": "从映射并行导入 CSV 到 staging"
    },
    {
      "path_contains": "services/ingest/merge",
      "summary": "窗口内去重/对齐并合并入事实表"
    },
    {
      "path_contains": "services/reporting/code_dist",
      "summary": "质量码分布报表导出（JSON/CSV）"
    },
    {
      "path_contains": "services/reporting/data_quality",
      "summary": "数据质量报表生成"
    },
    {
      "path_contains": "services/reporting/presence",
      "summary": "presence 计算/写入（分片+并发）"
    },
    {
      "path_contains": "services/rules/auto_baseline",
      "summary": "自动基线刷新（库端过程/影子方案）"
    },
    {
      "path_contains": "services/rules/metric_quality_rules",
      "summary": "质量规则生成/影子生成"
    },
    {
      "path_contains": "services/rules/running_thresholds",
      "summary": "设备运行阈值刷新/影子计算"
    }
  ],
  "names": {
    "record_timestamp": "记录时间戳（统一UTC）",
    "ts": "时间戳/时间字段",
    "value": "数值/指标值",
    "residual": "残差/偏差（质量/模型评估相关）",
    "quality_code": "质量码/命中码",
    "unit": "单位",
    "unit_display": "单位显示"
  },
